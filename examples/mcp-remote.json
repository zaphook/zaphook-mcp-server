{
  "mcpServers": {
    "zaphook": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.zaphook.cloud/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer YOUR_API_KEY"
      }
    }
  }
}
